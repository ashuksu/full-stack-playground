generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model products {
  id          Int      @id(map: "products_pk") @default(autoincrement())
  name        String?
  price       Decimal? @db.Decimal
  description String?
  image       String?
}
